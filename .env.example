# Node 24+; copy to .env. Never commit secrets or data/*.sqlite.
HOST=127.0.0.1
PORT=4310
HUDDLE_DB=./data/huddle.sqlite
# Required for a non-loopback bind OR non-loopback public origin; at least 24 chars.
# HUDDLE_ACCESS_SECRET=
# Exact public origin when using a trusted TLS reverse proxy (no trailing slash).
# HUDDLE_PUBLIC_ORIGIN=https://huddle.example.com
# Set only behind HTTPS. Never expose this server directly without TLS.
# HUDDLE_SECURE_COOKIE=true

# Only NVIDIA Build API and operator-configured local Ollama are supported.
# NVIDIA access/credits depend on your account; no guarantee of unlimited free use.
# NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
PROVIDER_TIMEOUT_MS=60000
# Deterministic demo is always available, explicitly selected, never a fallback.

# Generic open-model-compatible endpoints: exact HTTPS origins, comma-separated.
# The browser can configure paths only under origins explicitly permitted here.
# Costs and terms are yours to verify; Huddle never chooses a paid fallback.
# HUDDLE_ALLOWED_API_ORIGINS=https://models.example.com
# Optional protected master-key file location, outside your source checkout.
# HUDDLE_SECRET_KEY_FILE=/private/runtime/huddle-master-key
# Optional API-key environment references accepted by the connection form:
# HUDDLE_API_KEY_LOCAL=
